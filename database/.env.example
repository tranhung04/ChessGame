# ToolChess Database Configuration Example
# Copy this file to .env and update with your actual values

# Database Connection
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=ToolChessDB
DB_USER=sa
DB_PASSWORD=YourStrongPassword123!

# Connection String (Alternative)
# Use either individual settings above OR connection string below
DATABASE_URL=Server=localhost,1433;Database=ToolChessDB;User Id=sa;Password=YourStrongPassword123!;Encrypt=true;TrustServerCertificate=true;

# Environment
NODE_ENV=development

# Notes:
# - For Windows Authentication, use: Trusted_Connection=yes; instead of User Id and Password
# - For Azure SQL, use: Server=your-server.database.windows.net;
# - Always use strong passwords in production
# - Enable encryption in production: Encrypt=true;TrustServerCertificate=false;
