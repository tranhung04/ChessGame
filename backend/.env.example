# Server Configuration
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# Database Configuration
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=ToolChessDB
DB_USER=sa
# SECURITY: Use a strong password (16+ chars, mixed case, numbers, special chars)
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
DB_PASSWORD=your_strong_password_here_minimum_16_characters
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# JWT Configuration
# SECURITY: Generate strong random secrets for production
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_change_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# VNPay Configuration
# SECURITY: Get actual credentials from VNPay merchant dashboard
# Sandbox: https://sandbox.vnpayment.vn/
# Production: https://vnpay.vn/
VNPAY_TMN_CODE=your_vnpay_tmn_code_from_merchant_dashboard
VNPAY_HASH_SECRET=your_vnpay_hash_secret_from_merchant_dashboard
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/api/payment/vnpay/return

# Email Configuration (Gmail SMTP)
# SECURITY: Use Gmail App Password, not your regular password
# Generate at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password-16-characters
SMTP_FROM=ToolChess <noreply@toolchess.com>

# CORS Configuration
# SECURITY: Set specific origins in production, not wildcard (*)
# Development: http://localhost:19006,exp://localhost:19000
# Production: https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGIN=http://localhost:19006,exp://localhost:19000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
PAYMENT_RATE_LIMIT_MAX=3
