# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================
# SECURITY WARNING: Never commit actual .env.production file to version control
# This is a template - copy to .env.production and fill in actual values

# Server Configuration
NODE_ENV=production
PORT=3000
API_BASE_URL=https://api.toolchess.com

# Database Configuration
DB_SERVER=your-production-sql-server.database.windows.net
DB_PORT=1433
DB_DATABASE=ToolChessDB_Production
DB_USER=toolchess_admin
# SECURITY: Use strong password (16+ chars, mixed case, numbers, special chars)
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_MINIMUM_32_CHARACTERS
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# JWT Configuration
# SECURITY: Generate strong random secrets for production
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_THIS_GENERATE_WITH_CRYPTO_RANDOM_BYTES_64_HEX
JWT_REFRESH_SECRET=CHANGE_THIS_GENERATE_WITH_CRYPTO_RANDOM_BYTES_64_HEX
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# VNPay Configuration - PRODUCTION
# SECURITY: Get actual production credentials from VNPay merchant dashboard
# Production Portal: https://vnpay.vn/
VNPAY_TMN_CODE=YOUR_PRODUCTION_VNPAY_TMN_CODE
VNPAY_HASH_SECRET=YOUR_PRODUCTION_VNPAY_HASH_SECRET
VNPAY_URL=https://vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://api.toolchess.com/api/payment/vnpay/return

# Email Configuration (Gmail SMTP) - PRODUCTION
# SECURITY: Use Gmail App Password for production email account
# Generate at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@toolchess.com
SMTP_PASS=YOUR_PRODUCTION_GMAIL_APP_PASSWORD_16_CHARS
SMTP_FROM=ToolChess <noreply@toolchess.com>

# CORS Configuration - PRODUCTION
# SECURITY: Set specific origins, never use wildcard (*) in production
# Add your production mobile app domains and web domains
CORS_ORIGIN=https://toolchess.com,https://app.toolchess.com

# Rate Limiting - PRODUCTION (Stricter)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
AUTH_RATE_LIMIT_MAX=5
PAYMENT_RATE_LIMIT_MAX=3

# Logging Configuration
LOG_LEVEL=error
LOG_FILE_PATH=/var/log/toolchess/app.log

# Monitoring (Optional - if using monitoring service)
# MONITORING_API_KEY=your_monitoring_service_api_key
# SENTRY_DSN=your_sentry_dsn_for_error_tracking

# Performance
NODE_OPTIONS=--max-old-space-size=2048
