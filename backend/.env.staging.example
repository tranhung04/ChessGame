# ============================================
# STAGING ENVIRONMENT CONFIGURATION
# ============================================
# SECURITY WARNING: Never commit actual .env.staging file to version control
# This is a template - copy to .env.staging and fill in actual values

# Server Configuration
NODE_ENV=staging
PORT=3000
API_BASE_URL=https://staging-api.toolchess.com

# Database Configuration
DB_SERVER=your-staging-sql-server.database.windows.net
DB_PORT=1433
DB_DATABASE=ToolChessDB_Staging
DB_USER=toolchess_staging
# SECURITY: Use strong password (16+ chars, mixed case, numbers, special chars)
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_MINIMUM_24_CHARACTERS
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# JWT Configuration
# SECURITY: Use different secrets than production
JWT_ACCESS_SECRET=CHANGE_THIS_STAGING_ACCESS_SECRET_DIFFERENT_FROM_PROD
JWT_REFRESH_SECRET=CHANGE_THIS_STAGING_REFRESH_SECRET_DIFFERENT_FROM_PROD
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# VNPay Configuration - SANDBOX
# Use VNPay sandbox for staging environment
VNPAY_TMN_CODE=YOUR_VNPAY_SANDBOX_TMN_CODE
VNPAY_HASH_SECRET=YOUR_VNPAY_SANDBOX_HASH_SECRET
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://staging-api.toolchess.com/api/payment/vnpay/return

# Email Configuration (Gmail SMTP) - STAGING
# Use separate email account for staging
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=staging@toolchess.com
SMTP_PASS=YOUR_STAGING_GMAIL_APP_PASSWORD
SMTP_FROM=ToolChess Staging <staging@toolchess.com>

# CORS Configuration - STAGING
CORS_ORIGIN=https://staging.toolchess.com,https://staging-app.toolchess.com

# Rate Limiting - STAGING (More lenient for testing)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
PAYMENT_RATE_LIMIT_MAX=5

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=/var/log/toolchess/staging-app.log
